msgid "upload.usage.limit_hint"
msgstr ""
"※ अधिकतम %(max_files)s फ़ाइलें, कुल %(max_total_mb)s MB तक अपलोड की जा "
"सकती हैं।"

msgid "viewer_id が必要です。"
msgstr "viewer_id आवश्यक है।"

msgid "… KBの約1000倍。写真や音楽1曲くらい"
msgstr "… केबी (KB) का लगभग 1000 गुना। लगभग एक फ़ोटो या एक गाना"

msgid "… MBの約1000倍。動画やアプリ、スマホの保存容量"
msgstr "… एमबी (MB) का लगभग 1000 गुना। वीडियो, ऐप या स्मार्टफोन की स्टोरेज क्षमता"

msgid "… 一番小さい。短い文章やアイコン程度"
msgstr "… सबसे छोटा। जैसे कोई संक्षिप्त संदेश या छोटा आइकॉन"

msgid "※最大ファイル、合計MBまで扱えます。"
msgstr "*निर्धारित अधिकतम फ़ाइल संख्या और कुल आकार सीमा तक समर्थित है।"

msgid "※注意点として、古いiPadをサブディスプレイとして長時間利用する場合、バッテリーが熱を持ちやすくなります。画面の輝度を少し下げ、風通しの良い場所で利用することで、端末の寿命を長持ちさせることができます。"
msgstr ""
"ध्यान दें: पुराने आईपैड का सब-डिस्प्ले के रूप में लंबे समय तक उपयोग करने "
"से बैटरी गर्म हो सकती है। स्क्रीन की ब्राइटनेस को कम रखकर और इसे हवादार "
"जगह पर इस्तेमाल करके आप डिवाइस की लाइफ बढ़ा सकते हैं।"

msgid "※注意点：この方法は非常に手軽ですが、書き出し後の画質がかなり荒くなってしまうことがあります。特に細かい文字や図面が含まれるPDFの場合は、保存後にファイルを開き、可読性に問題がないか必ず確認してください。"
msgstr ""
"※ ध्यान दें: यह तरीका बहुत आसान है, लेकिन इसके बाद इमेज क्वालिटी काफ़ी कम"
" हो सकती है। ख़ासकर अगर PDF में छोटे टेक्स्ट या डायग्राम हैं, तो सेव करने"
" के बाद फ़ाइल को खोलकर ज़रूर चेक कर लें कि सब कुछ साफ़-साफ़ पढ़ा जा रहा "
"है या नहीं।"

msgid "※目の前にQRコードがないリモート環境の場合は、メールやチャットツール（LINEやSlackなど）で送られてきた共有用のURLを直接タップするだけで、同様にダウンロードページへアクセスできます。"
msgstr ""
"※यदि आप ऐसे रिमोट वातावरण में हैं जहाँ क्यूआर (QR) कोड आपके सामने नहीं "
"है, तो आप ईमेल या चैट टूल (जैसे LINE या Slack आदि) द्वारा भेजे गए शेयरिंग"
" यूआरएल (URL) पर सीधे टैप करके भी डाउनलोड पेज पर पहुँच सकते हैं।"

msgid "→他のファイルをアップロード"
msgstr "→अन्य फ़ाइलें अपलोड करें"

msgid ""
"①QRコードを保存せずページを閉じてしまった → 共有IDとパスワードが分かれば検索ページから開けます。②パスワードを忘れた → "
"パスワードのリセット機能はないため、アップロード時にメモを残してください。③保存期間を過ぎてダウンロードしようとした → "
"期限切れのファイルは自動削除済みです。"
msgstr ""
"1. आपने क्यूआर कोड को सेव किए बिना पेज बंद कर दिया है: यदि आप शेयर आईडी "
"और पासवर्ड जानते हैं, तो इसे सर्च पेज से खोलें। 2. आप पासवर्ड भूल गए: "
"पासवर्ड रीसेट नहीं किया जा सकता, इसलिए अपलोड करते समय ध्यान रखें। 3. आपने"
" अवधारण अवधि के बाद डाउनलोड करने का प्रयास किया: समाप्त फ़ाइलें पहले ही "
"हटा दी गई हैं।"

msgid ""
"①QRコードを保存せずページを閉じてしまった → 検索ページでファイル名から再検索できます。②パスワードを忘れた → "
"パスワードのリセット機能はないため、アップロード時にメモを残してください。③7日を過ぎてダウンロードしようとした → "
"期限切れのファイルは自動削除済みです。"
msgstr ""
"1. आपने क्यूआर कोड सहेजे बिना पृष्ठ बंद कर दिया है: खोज पृष्ठ पर फ़ाइल "
"नाम से दोबारा खोजें। 2. आप पासवर्ड भूल गए: पासवर्ड रीसेट नहीं किया जा "
"सकता, इसलिए अपलोड करते समय ध्यान रखें। 3. आपने 7 दिनों के बाद डाउनलोड "
"करने का प्रयास किया: समाप्त फ़ाइलें पहले ही स्वचालित रूप से हटा दी गई "
"हैं।"

msgid ""
"①アクセスキーを忘れてルームに入れない → 検索ページでルーム名から探せます。②別のメンバーが誤って内容を消してしまった → "
"変更履歴から復元できます。③スマホから編集しにくい → 横向き（ランドスケープ）にすると編集エリアが広くなります。"
msgstr ""
"1. आप एक्सेस कुंजी भूल गए हैं और कमरे में प्रवेश नहीं कर सकते: खोज पृष्ठ "
"पर कमरे के नाम से खोजें। 2. किसी अन्य सदस्य ने गलती से सामग्री हटा दी: "
"इसे परिवर्तन इतिहास से पुनर्स्थापित करें। 3. स्मार्टफोन पर संपादन करना "
"कठिन लगता है: व्यापक संपादन क्षेत्र के लिए लैंडस्केप मोड में घुमाएँ।"

msgid ""
"①アクセスキーを紛失した → ルームの管理画面からキーを再発行できます。②ファイルをどのルームにアップしたか分からなくなった → "
"検索機能でファイル名から探せます。③古いファイルと新しいファイルが混在する → フォルダで整理することを推奨します。"
msgstr ""
"1. आपने एक्सेस कुंजी खो दी है: इसे कक्ष प्रबंधन स्क्रीन से पुनः जारी "
"करें। 2. आप भूल गए कि किस कमरे में फ़ाइल है: फ़ाइल नाम से खोजें। 3. "
"पुरानी और नई फ़ाइलें एक साथ मिश्रित होती हैं: उन्हें फ़ोल्डरों के साथ "
"व्यवस्थित करें।"

msgid ""
"①パスワードを忘れた → 再発行機能はないため、作成時に控えてください。②どのルームか分からなくなった → "
"ルームIDとパスワードが分かれば検索ページから参加できます。③古いファイルと新しいファイルが混在する → "
"ファイル名で版や日付が分かるようにしてからアップロードしてください。"
msgstr ""
"1. आप पासवर्ड भूल गए हैं: पासवर्ड दोबारा जारी नहीं किए जा सकते, इसलिए रूम"
" बनाते समय ध्यान रखें। 2. आप नहीं जानते कि यह कौन सा कमरा है: यदि आप कमरे"
" का आईडी और पासवर्ड जानते हैं, तो खोज पृष्ठ से जुड़ें। 3. पुरानी और नई "
"फ़ाइलें मिश्रित होती हैं: अपलोड करने से पहले फ़ाइल नाम में संस्करण या "
"दिनांक शामिल करें।"

msgid ""
"①パスワードを忘れてルームに入れない → 再発行機能はないため、作成時に控えてください。②別のメンバーが誤って内容を消してしまった → "
"履歴復元はできないため、重要な内容は定期的にコピーしてください。③スマホから編集しにくい → "
"横向き（ランドスケープ）にすると編集エリアが広くなります。"
msgstr ""
"1. आप पासवर्ड भूल गए हैं और कमरे में प्रवेश नहीं कर सकते: पासवर्ड दोबारा "
"जारी नहीं किए जा सकते, इसलिए कमरा बनाते समय ध्यान रखें। 2. किसी अन्य "
"सदस्य ने गलती से सामग्री हटा दी: इतिहास पुनर्स्थापना अनुपलब्ध है, इसलिए "
"महत्वपूर्ण सामग्री को नियमित रूप से कॉपी करें। 3. स्मार्टफोन पर संपादन "
"करना कठिन लगता है: व्यापक संपादक के लिए लैंडस्केप मोड में घुमाएँ।"

msgid "■ Androidの場合"
msgstr "■ Android के लिए"

msgid "■ iPhone（iOS）の場合"
msgstr "■ iPhone (iOS) के लिए"

msgid "。たとえば「500MB」と「1GB」では1GBのほうが2倍大きい、という関係になります。（厳密にはコンピュータ内部では1024倍で計算されますが、ざっくり理解するなら1000倍で問題ありません。）"
msgstr ""
"। उदाहरण के लिए, '500MB' और '1GB' में से 1GB आकार में दोगुना बड़ा होता "
"है। (सटीक रूप से कहें तो, कंप्यूटर के भीतर इसकी गणना 1024 गुना के रूप में"
" की जाती है, लेकिन आसान समझ के लिए इसे 1000 गुना मानना भी पर्याप्त है।)"

msgid "「Files by Google」アプリ、または端末にプリインストールされている「マイファイル」「ファイル」アプリを起動します。"
msgstr ""
"\"Files by Google\" ऐप, या अपने डिवाइस पर पहले से इंस्टॉल किए गए \"My "
"Files\" या \"Files\" ऐप को खोलें।"

msgid "「ID・パスワードでアクセスを制限したファイル共有リンク」"
msgstr "「सुरक्षित फ़ाइल शेयरिंगリンク」"

msgid "「PDFファイルのサイズが大きすぎてメールに添付できない」「共有するのに時間がかかる」とお悩みではありませんか？本記事では、MacやWindowsの標準機能から無料のWebツールまで、安全にPDFを圧縮して容量を軽くする手順をわかりやすく解説します。"
msgstr ""
"क्या आप भी इस बात से परेशान हैं कि 'PDF फ़ाइलों का साइज़ बहुत बड़ा होने "
"के कारण ईमेल में अटैच नहीं हो पा रही हैं' या 'इन्हें शेयर करने में बहुत "
"समय लग रहा है'? इस लेख में, हम Mac और Windows के डिफ़ॉल्ट फीचर्स से लेकर "
"मुफ़्त वेब टूल्स तक, PDF फ़ाइलों को सुरक्षित रूप से कंप्रेस करके उनका "
"साइज़ कम करने के आसान तरीके बताएंगे।"

msgid "「Reduce File Size（ファイルサイズを縮小）」"
msgstr "\"Reduce File Size\" (फ़ाइल आकार घटाएं)"

msgid "「URLだけ」では不十分なときのために"
msgstr "हर स्थिति में जब 'केवल यूआरएल' पर्याप्त नहीं है"

msgid "「URLの共有だけ」では防げないリスクとパスワード保護の必要性"
msgstr "केवल 'URL शेयर करने' से न रुकने वाले जोखिम और पासवर्ड सुरक्षा की ज़रूरत"

msgid "「Windowsキー + Alt + R」"
msgstr "'Windows Key + Alt + R'"

msgid "「Windowsキー + G」"
msgstr "'Windows Key + G'"

msgid "「Windowsキー + Shift + S」"
msgstr "'Windows Key + Shift + S'"

msgid "「iPhoneからAndroidへ」「スマホからパソコンへ」のように端末やOSをまたいで送る場合、AirDropのような専用機能は使えず、チャットアプリ任せだと圧縮されがちです。こうしたときに最も確実なのが、写真を"
msgstr ""
"जब आप 'iPhone से Android' या 'स्मार्टफोन से कंप्यूटर' जैसे अलग-अलग डिवाइस"
" या OS के बीच फ़ाइलें भेजते हैं, तो AirDrop जैसी खास सुविधाएं काम नहीं "
"करती हैं, और चैट ऐप से भेजने पर अक्सर फ़ोटो कंप्रेस हो जाती हैं। ऐसे समय "
"में सबसे सुरक्षित तरीका यह है कि फ़ोटो को"

msgid "「この写真、何MBあるの？」「動画を送ろうとしたらGBって出たけど大きいの？」——スマートフォンやパソコンを使っていると必ず目にするKB・MB・GBという単位。なんとなく使っているものの、それぞれの違いや実際の大きさのイメージが曖昧なままの方も多いのではないでしょうか。本記事では、これらの単位の関係を初心者向けに整理し、写真や動画が実際どれくらいの容量になるのかを具体的な目安とともに解説します。"
msgstr ""
"“यह फ़ोटो कितने MB की है?” “वीडियो भेजते समय GB दिख रहा है, क्या यह बहुत "
"बड़ा है?” स्मार्टफोन या कंप्यूटर इस्तेमाल करते समय KB, MB और GB जैसी "
"इकाइयाँ अक्सर दिखती हैं। बहुत से लोग इन्हें इस्तेमाल तो करते हैं, लेकिन "
"इनके अंतर और वास्तविक आकार की कल्पना स्पष्ट नहीं होती। इस लेख में शुरुआती"
" लोगों के लिए इन इकाइयों का संबंध समझाया गया है और फ़ोटो व वीडियो का आकार"
" कितना होता है, इसके ठोस अनुमान दिए गए हैं।"

msgid "「どこで撮ったか」を示す位置情報（GPS座標）"
msgstr ""
"लोकेशन डेटा (GPS कोऑर्डिनेट्स) जो यह बताता है कि तस्वीर 'कहाँ' खींची गई "
"थी,"

msgid "「アプリをインストールして」と言う必要はありません"
msgstr "'ऐप इंस्टॉल करें' ऐसा कहने की ज़रूरत नहीं है"

msgid "「イベント期間中だけ閲覧可能にしたい」という場合も、FS!QRの有効期限設定が役立ちます。一定期間が過ぎれば自動的にアクセスできなくなるため、機密性の高い勉強会の資料なども安心して配布できます。"
msgstr ""
"FS!QR पर वैधता अवधि निर्धारित करना भी उपयोगी है जब आप चाहते हैं कि "
"दस्तावेज़ केवल कार्यक्रम की अवधि के दौरान ही दिखाई दे। चूंकि पहुंच अधिकार"
" एक निश्चित समय के बाद स्वचालित रूप से बंद हो जाते हैं, इसलिए आप अत्यधिक "
"सुरक्षित सेमिनार दस्तावेजों को भी सुरक्षित रूप से वितरित कर सकते हैं।"

msgid "「カテゴリ」セクションにある「ダウンロード」をタップします。"
msgstr "\"Categories\" सेक्शन में मौजूद \"Downloads\" पर टैप करें।"

msgid "「クラウドストレージは月額料金がかかるし、PCに繋ぐケーブルを探すのも面倒……」という時に便利なのが、登録不要で使える無料ファイル共有サービス"
msgstr ""
"जब आपको लगे कि 'क्लाउड स्टोरेज के लिए हर महीने पैसे देने पड़ते हैं और "
"पीसी से कनेक्ट करने के लिए केबल ढूँढना भी झंझट है...', तो ऐसे में बिना "
"अकाउंट बनाए इस्तेमाल होने वाली मुफ़्त फ़ाइल शेयरिंग सर्विस बहुत काम आती "
"है"

msgid "「グループの作成」を選択し、ルームIDの自動生成または手動入力と保存期間を指定してルームを作成します。6桁のパスワードが自動生成されます。"
msgstr ""
"ग्रुप बनाएं चुनें, स्वचालित या मैन्युअल रूम आईडी प्रविष्टि और एक अवधारण "
"अवधि चुनें, फिर रूम बनाएं। 6 अंकों का पासवर्ड स्वचालित रूप से उत्पन्न "
"होता है।"

msgid "「グループの作成」を選択し、ルーム名と共有したいメンバーの情報を登録します。アクセスキーは自動生成されます。"
msgstr ""
"\"समूह बनाएं\" चुनें और रूम का नाम और उन सदस्यों की जानकारी दर्ज करें "
"जिन्हें आप साझा करना चाहते हैं। एक्सेस कीज़ स्वचालित रूप से उत्पन्न होती "
"हैं।"

msgid "「グループの作成」ボタンをクリックしてファイル共有用のルームを作成します。"
msgstr "फ़ाइल साझाकरण के लिए रूम बनाने के लिए \"समूह बनाएं\" बटन पर क्लिक करें।"

msgid "「コンテンツ」とは、利用者が本サービスを通じてアップロード・投稿・送信するファイル、テキストその他一切の情報をいいます。"
msgstr ""
"\"सामग्री\" फ़ाइलों, पाठ और किसी भी अन्य जानकारी को संदर्भित करती है जिसे"
" उपयोगकर्ता सेवा के माध्यम से अपलोड, पोस्ट या प्रसारित करते हैं।"

msgid "「システムが発行した一時ID」と「送信者が設定したパスワード」の2つの組み合わせ"
msgstr ""
"'सिस्टम द्वारा जारी की गई अस्थायी ID' और 'भेजने वाले द्वारा सेट किया गया "
"पासवर्ड' का मेल"

msgid "「スタート」をクリックするとカウントダウン後に録画が始まります。"
msgstr "\"Start\" पर क्लिक करें, और काउंटडाउन के बाद रिकॉर्डिंग शुरू हो जाएगी।"

msgid "「データは蓄積するもの」という常識から、「必要なときだけ存在する」という考え方へ。自動削除機能を賢く使って、管理の手間とリスクを最小限に抑えたスマートなファイル共有を体験してください。"
msgstr ""
"\"डेटा संचित (इकट्ठा) करने की चीज़ है\" के पुराने विचार से \"केवल "
"आवश्यकता पड़ने पर मौजूद रहने\" की अवधारणा की ओर। ऑटो-डिलीट फ़ीचर का "
"बुद्धिमानी से उपयोग करके प्रबंधन के झंझटों और जोखिमों को न्यूनतम रखने "
"वाले स्मार्ट फ़ाइल साझाकरण का अनुभव करें।"

msgid "「ファイル」 ＞ 「名前を付けて保存」を選択します。"
msgstr "\"File\" > \"Save As\" चुनें।"

msgid "「ファイル」として共有する："
msgstr "'फ़ाइल' के रूप में शेयर करें:"

msgid "「ファイルが見つかりません」またはエラーが表示される"
msgstr "\"फ़ाइल नहीं मिली\" या कोई त्रुटि (एरर) प्रदर्शित होना"

msgid "「ファイルを一時的に渡したいが、相手にアカウントを作ってもらうほどではない」という場面があります。FS!QRは、この短時間の受け渡しを、URLまたはQRコードとパスワードで行うためのサービスです。ここでは広告的な機能紹介ではなく、共有を始めてから期限が切れるまでに何が起きるかを、利用者が判断できる粒度で説明します。"
msgstr ""
"कभी-कभी किसी फ़ाइल को थोड़े समय के लिए देना होता है, लेकिन सामने वाले से "
"अकाउंट बनवाना ज़रूरी नहीं लगता। FS!QR URL या QR कोड और पासवर्ड के ज़रिए "
"ऐसे कम समय वाले हस्तांतरण के लिए बनाया गया है। यह गाइड केवल प्रचारात्मक "
"फ़ीचर्स नहीं गिनाती, बल्कि शेयरिंग शुरू होने से उसकी समय-सीमा खत्म होने "
"तक क्या होता है, यह सही निर्णय लेने लायक विस्तार से समझाती है।"

msgid "「ファイルアップロード」からファイルを選択し、暗号化アップロードを行います。"
msgstr "\"फ़ाइल अपलोड\" से फ़ाइल चुनें और इसे एन्क्रिप्टेड अपलोड करें।"

msgid "「ファイルアップロード」を選択し、共有したいファイルを追加します。自動的に暗号化とQRコード生成が始まります。"
msgstr ""
"\"फ़ाइल अपलोड\" चुनें और वे फ़ाइलें जोड़ें जिन्हें आप साझा करना चाहते "
"हैं। एन्क्रिप्शन और क्यूआर कोड जेनरेशन स्वचालित रूप से शुरू हो जाएगा।"

msgid "「ブラウザさえあれば送れる」という安心感は、ビジネスでもプライベートでも大きな武器になります。ツールの導入障壁をゼロにして、もっと自由に、もっと素早く大容量ファイルを共有してみませんか？"
msgstr ""
"यह सुविधा कि आप 'सिर्फ ब्राउज़र की मदद से फाइलें भेज सकते हैं', काम और "
"निजी ज़िंदगी दोनों में एक बहुत बड़ा फायदा है। किसी भी टूल को इंस्टॉल करने"
" की झंझट को छोड़ें और बड़ी फ़ाइलों को आज़ादी और तेज़ी से शेयर करें।"

msgid "「ブラウズ」タブを選択し、「このiPhone内」または「iCloud Drive」の中にある「ダウンロード」フォルダを開きます。"
msgstr ""
"\"Browse\" टैब चुनें और \"On My iPhone\" या \"iCloud Drive\" के भीतर "
"स्थित \"Downloads\" फ़ोल्डर खोलें।"

msgid "「ボードを作成」ボタンをクリックし、保存期間を指定してタスクボードを作成します。"
msgstr "「ボードをबनाएँ」ボタンをクリックし、सेव रखने की अवधिを指定してタスクボードをबनाएँします。"

msgid "「ボードを作成」ボタンを押し、保存期間（1日・1週間・1か月）を選択してボードを発行します。"
msgstr "「ボードをबनाएँ」ボタンを押し、सेव रखने की अवधि（1 दिन・1週間・1か月）を選択してボードを発行します。"

msgid "「リンクです」だけでなく、何のファイルか、どこを確認してほしいか、いつまでに返信が必要かを書きます。受信者が予想していない共有なら、リンクを開く前に送信者へ別の手段で確認してもらいます。ファイル共有サービスを装ったフィッシングもあるため、ドメイン名と依頼内容が一致しているかを確認します。"
msgstr ""
"केवल “यह रहा लिंक” न लिखें; फ़ाइल क्या है, किस बात की जाँच करनी है और कब "
"तक उत्तर चाहिए, यह भी बताएँ। यदि प्राप्तकर्ता को साझा की गई फ़ाइल की "
"अपेक्षा नहीं थी, तो लिंक खोलने से पहले उससे दूसरे माध्यम से भेजने वाले की"
" पुष्टि करवाएँ। फ़ाइल-साझाकरण सेवा का रूप धरकर फ़िशिंग की जा सकती है, "
"इसलिए जाँचें कि डोमेन नाम अनुरोध से मेल खाता है।"

msgid "「ルームを作成」を押し、ルームIDの自動生成または手動入力と保存期間を指定すると、共同編集用のルームが作成されます。"
msgstr ""
"क्रिएट रूम दबाएं, स्वचालित या मैन्युअल रूम आईडी प्रविष्टि और एक अवधारण "
"अवधि चुनें, फिर एक सहयोगी संपादन कक्ष बनाएं।"

msgid "「ルームを作成」を押してタイトルと概要を入力すると、共同編集用のルームがすぐに作成されます。"
msgstr ""
"\"रूम बनाएं\" दबाएं और तुरंत एक सहयोगी रूम बनाने के लिए शीर्षक और विवरण "
"दर्ज करें।"

msgid "「ルームを作成」ボタンをクリックしてノートルームを作成します。"
msgstr "नोट्स रूम बनाने के लिए \"रूम बनाएं\" बटन पर क्लिक करें।"

msgid "「二重の丸いアイコン（画面収録ボタン）」をタップします。"
msgstr "\"Double circle icon (स्क्रीन रिकॉर्डिंग बटन)\" पर टैप करें।"

msgid "「今すぐファイルを送りたいのに…」登録の壁"
msgstr "पंजीकरण की बाधा: 'मैं अभी फाइलें भेजना चाहता हूँ लेकिन...'"

msgid "「会員登録不要」がセキュリティリスクを下げる理由"
msgstr "पंजीकरण के बिना फ़ाइल भेजने के सुरक्षा लाभ"

msgid "「使い捨て」感覚の気軽さ："
msgstr "'एक बार इस्तेमाल करके हटाने' (वन-टाइम यूज़) जैसी आसान सुविधा:"

msgid "「使い捨て」感覚の気軽さ：一度きりのファイル受け渡しのために、わざわざ新しいアプリを入れたり、使わないアカウントを増やしたりしたくない場合に最適です。"
msgstr ""
"'एक बार उपयोग करके फेंकने' जैसा अनुभव: यह तब सबसे उपयुक्त होता है जब आप "
"केवल एक बार फ़ाइल स्थानांतरित करने के लिए एक नया ऐप इंस्टॉल करने या "
"अप्रयुक्त खातों को बढ़ाने की परेशानी से बचना चाहते हैं।"

msgid "「保存」をクリックします。"
msgstr "और \"Save\" पर क्लिक करें।"

msgid "「保存」をクリックすると、圧縮されたPDFが新しく書き出されます。"
msgstr "'Save' पर क्लिक करने से कंप्रेस की गई नई PDF सेव हो जाएगी।"

msgid "「元のサイズ」オプションを探す："
msgstr "'ओरिजिनल साइज़' का विकल्प खोजें:"

msgid "「利用者」とは、個人・法人・団体を問わず、本サービスを利用するすべての者をいいます。"
msgstr ""
"\"उपयोगकर्ता\" उन सभी व्यक्तियों को संदर्भित करता है जो इस सेवा का उपयोग "
"करते हैं, भले ही वे व्यक्ति, निगम या संगठन हों।"

msgid "「収録」をクリックすると録画がスタートします。"
msgstr "रिकॉर्डिंग शुरू करने के लिए \"Record\" पर क्लिक करें।"

msgid "「取引先に急いで資料を送らなければならない」「イベントで撮った集合写真をすぐにみんなとシェアしたい」——そんな時、ファイル共有サービスを開いて「アカウントを作成してください」という画面が出ると、一気に気持ちが萎えてしまいませんか？"
msgstr ""
"'क्लाइंट को जल्दबाजी में दस्तावेज़ भेजने हैं' या 'कार्यक्रम में खींची गई "
"समूह तस्वीर सभी को तुरंत साझा करनी है' — ऐसे समय में, जब आप फ़ाइल साझाकरण"
" सेवा खोलते हैं और स्क्रीन पर 'कृपया खाता बनाएं' लिखा हुआ आता है, तो क्या"
" आपका उत्साह तुरंत कम नहीं हो जाता?"

msgid "「圧縮したけれど、どうしてもメールの添付上限を超えてしまう」「機密情報なので、外部のオンライン圧縮ツールは使いたくない」という場合には、メール添付ではなく<strong>「ID・パスワードでアクセスを制限したファイル共有リンク」</strong>を生成して送る方法が最適です。"
msgstr ""
"अगर आपको लगता है कि 'कंप्रेस करने के बाद भी ईमेल की लिमिट पार हो रही है' "
"या 'फ़ाइल कॉन्फिडेंशियल है, इसलिए बाहरी ऑनलाइन टूल्स का इस्तेमाल नहीं "
"करना है', तो सबसे अच्छा तरीका है कि उसे ईमेल में अटैच करने के बजाय "
"<strong>'ID/पासवर्ड वाली सुरक्षित फ़ाइल शेयरिंग लिंक'</strong> बनाकर भेजा"
" जाए।"

msgid "「後でメールします」を撲滅する！イベント当日の即時共有"
msgstr ""
"\"मैं आपको बाद में ईमेल करूँगा\" की प्रथा को समाप्त करें! इवेंट के दिन ही"
" तुरंत शेयरिंग"

msgid "「後で送ります」という手間がなくなる"
msgstr "'मैं इसे बाद में भेजूंगा' कहने की परेशानी को समाप्त करें"

msgid "「急ぎ」「今日中」「確認だけ」といった言葉で判断を急がせる共有依頼ほど、送信者確認を省略しないことが大切です。"
msgstr ""
"जल्दी, आज ही, या सिर्फ जाँच जैसे शब्दों से निर्णय जल्दी कराने वाले "
"अनुरोधों में भेजने वाले की पुष्टि छोड़ना नहीं चाहिए।"

msgid "「授業中の1時間だけ参照させたい」「試験前の勉強用として3日間だけ公開したい」という場合は、保持期間を短く設定します。期間終了後は共有リンクが無効になり、サービスが管理する登録情報と保存ファイルが削除されます。生徒が端末へ保存した教材のコピーやスクリーンショットまでは消せないため、配布する内容の範囲を確認してから利用してください。"
msgstr ""
"रखने की अवधि समाप्त होने पर सेवा अपने प्रबंधित रिकॉर्ड और फ़ाइलें हटा "
"देती है; बैकअप और प्राप्तकर्ता के डिवाइस पर सहेजी गई प्रतियां रह सकती "
"हैं।"

msgid "「数字を言われてもピンとこない」という方のために、身近なデータのおおよその容量を一覧にまとめました。あくまで目安で、画質や長さによって変わります。"
msgstr ""
"यदि आप 'संख्याओं (आंकड़ों) को देखकर अंदाज़ा नहीं लगा पाते', तो हमने आम "
"उपयोग में आने वाले डेटा के अनुमानित आकार की एक सूची तैयार की है। यह केवल "
"एक अनुमान है, जो गुणवत्ता और अवधि के आधार पर बदल सकता है।"

msgid "「新規」をクリックし、画面上の録画したい範囲をドラッグで囲みます。"
msgstr ""
"\"New\" पर क्लिक करें और स्क्रीन के उस क्षेत्र को चुनने के लिए ड्रैग करें"
" जिसे आप रिकॉर्ड करना चाहते हैं।"

msgid "「日々の学びを活かして、誰もが安全にデータを共有できる環境を提供したい。」そんな想いからFS!QRを運営しています。これからも利用者の皆さまに寄り添いながら、より便利で信頼できるサービスへと成長させていきます。"
msgstr ""
"\"हम एक ऐसा वातावरण प्रदान करना चाहते हैं जहाँ हर कोई सुरक्षित रूप से "
"डेटा शेयर कर सके।\" यही FS!QR के पीछे का विचार है। हम अपने उपयोगकर्ताओं "
"की बात सुनना जारी रखेंगे और एक अधिक सुविधाजनक और विश्वसनीय सेवा के रूप "
"में विकसित होंगे।"

msgid "「暗号化されているから安全」と一言で説明すると、どの段階が保護されているのかが分からなくなります。ファイル共有では、送信端末からサーバーまでの通信、サーバー上の保存、受信者の端末に保存された後を分けて考える必要があります。暗号化は重要な対策ですが、宛先確認やパスワード管理を置き換えるものではありません。"
msgstr ""
"“एन्क्रिप्टेड है, इसलिए सुरक्षित है” कहना पर्याप्त नहीं है, क्योंकि इससे "
"यह अस्पष्ट रहता है कि कौन-सा चरण सुरक्षित है। फ़ाइल साझा करते समय भेजने "
"वाले उपकरण से सर्वर तक का संचार, सर्वर पर संग्रह और प्राप्तकर्ता के उपकरण"
" में सहेजे जाने के बाद की स्थिति को अलग-अलग समझें। एन्क्रिप्शन महत्वपूर्ण"
" उपाय है, लेकिन यह प्राप्तकर्ता की जाँच या पासवर्ड प्रबंधन का विकल्प नहीं"
" है।"

msgid "「最小サイズ（オンライン発行向け）」"
msgstr "\"Minimum size (publishing online)\" (न्यूनतम आकार)"

msgid "「最新版.pdf」「資料2.pdf」のような名前は、やり取りが増えるほど混乱の原因になります。外部の相手と共有するファイルほど、ファイル名で説明できる状態にしておきましょう。"
msgstr ""
"“latest.pdf” या “document2.pdf” जैसे नाम आदान-प्रदान बढ़ने पर भ्रम का "
"कारण बनते हैं। बाहरी पक्ष के साथ साझा की जाने वाली फ़ाइलों में फ़ाइल नाम "
"से ही सामग्री समझ आनी चाहिए।"

msgid "「最近削除した項目」（iPhone）または「ゴミ箱」（Android）のフォルダを開いて、「すべて削除」を実行"
msgstr ""
"'रिसेंटली डिलीटेड' (iPhone) या 'ट्रैश' (Android) फ़ोल्डर में जाकर 'सभी को"
" डिलीट करें' पर टैप करें"

msgid "「本サービス」とは、ファイル共有・QRコード生成・グループ共有・ノート共有など、運営者が「FS!QR」の名称で提供する一連の機能をいいます。"
msgstr ""
"\"यह सेवा\" \"FS!QR\" नाम के तहत ऑपरेटर द्वारा प्रदान किए गए कार्यों की "
"एक श्रृंखला को संदर्भित करती है, जैसे फ़ाइल शेयरिंग, क्यूआर कोड जनरेशन, "
"समूह शेयरिंग और नोट शेयरिंग।"

msgid "「消える」からこそ安心して送れる"
msgstr "चूंकि यह 'गायब' हो जाता है, इसलिए आप इसे बेफिक्र होकर भेज सकते हैं"

msgid "「画面収録」"
msgstr "\"Screen Recording\" (स्क्रीन रिकॉर्डिंग)"

msgid "「確認後はローカルから削除してください」「編集後のファイルはこのルームではなく指定の方法で戻してください」「社外への転送は禁止です」のように、期待する行動を具体的に書きます。特に、社外の協力会社や一時的なメンバーへ共有する場合は、再共有の可否を明確にしましょう。ファイルを渡すことは、その後の管理方針を渡すことでもあります。"
msgstr ""
"आप क्या चाहते हैं, इसे साफ़-साफ़ लिखें — जैसे: \"चेक करने के बाद कृपया "
"फ़ाइल को अपनी ड्राइव से डिलीट कर दें,\" \"एडिट की गई फ़ाइल को इस रूम के "
"बजाय बताए गए तरीके से वापस भेजें,\" या \"इस फ़ाइल को कंपनी के बाहर किसी "
"को भेजना मना है।\" ख़ासकर जब आप बाहरी पार्टनर कंपनियों या अस्थायी टीम "
"मेंबर्स के साथ कुछ शेयर कर रहे हों, तो यह स्पष्ट कर दें कि वे इसे आगे "
"किसी और के साथ शेयर कर सकते हैं या नहीं। किसी को फ़ाइल सौंपने का मतलब यह "
"भी है कि आप उसे यह ज़िम्मेदारी दे रहे हैं कि वह इसे कैसे सँभालेगा।"

msgid "「経路の分離（Out-of-Band）」でさらに安全性を高める実務手順"
msgstr ""
"'रास्ते अलग करने (Out-of-Band)' से सुरक्षा को और बढ़ाने के व्यावहारिक "
"तरीके"

msgid "「設定」→「プライバシーとセキュリティ」→「位置情報サービス」→「カメラ」を「許可しない」にすると、以降の撮影で位置情報が記録されなくなります。"
msgstr ""
"'Settings' → 'Privacy & Security' → 'Location Services' → 'Camera' में "
"जाकर इसे 'Never' पर सेट करें। इसके बाद आपके द्वारा खींची गई किसी भी "
"तस्वीर में लोकेशन रिकॉर्ड नहीं होगी।"

msgid "「設定」アプリ ＞ 「コントロールセンター」を開き、「コントロールを追加」リストの中から"
msgstr "'Settings' ऐप > 'Control Center' खोलें, और 'More Controls' की सूची से"

msgid ""
"「設定」アプリ ＞「ストレージ」（または「デバイスケア」 "
"＞「ストレージ」）をタップします。画像、動画、システム、アプリなどのカテゴリ別に容量が表示されます。"
msgstr ""
"'सेटिंग्स' ऐप > 'स्टोरेज' (या 'डिवाइस केयर' > 'स्टोरेज') पर टैप करें। "
"यहाँ आपको इमेज, वीडियो, सिस्टम और ऐप्स जैसी कैटेगरी के हिसाब से स्टोरेज "
"का इस्तेमाल दिखाई देगा।"

msgid ""
"「設定」アプリ ＞「一般」 "
"＞「iPhoneストレージ」の順にタップします。グラフで写真、アプリ、システムなどの内訳が表示され、どのアプリが容量を多く消費しているかがリストで確認できます。"
msgstr ""
"'सेटिंग्स' ऐप > 'जनरल' > 'iPhone स्टोरेज' पर टैप करें। आपको फ़ोटो, ऐप्स, "
"सिस्टम आदि का एक ग्राफ़ दिखेगा, और आप लिस्ट में देख सकते हैं कि कौन से "
"ऐप्स सबसे ज़्यादा स्टोरेज ले रहे हैं।"

msgid "「送りっぱなし」が招く恐ろしいセキュリティリスク"
msgstr "फ़ाइलें 'भेजकर भूल जाने' के कारण पैदा होने वाले गंभीर सुरक्षा जोखिम"

msgid "「送りっぱなし」による情報漏洩を防ぐ"
msgstr "'भेजकर छोड़ देने' के कारण होने वाले सूचना रिसाव को रोकें"

msgid "「送りっぱなし」のリスクを防ぐ。FS!QRの自動削除機能がなぜセキュリティに有効なのか、その理由を詳しく紐解きます。"
msgstr ""
"फ़ाइल 'भेजकर भूल जाने' के जोखिम को रोकें। आइए विस्तार से जानें कि FS!QR "
"का ऑटो-डिलीट फ़ीचर सुरक्षा के लिए इतना असरदार क्यों है।"

msgid "「連絡経路を切り分ける（分離する）」"
msgstr "कम्युनिकेशन चैनल्स को अलग-अलग करना"

msgid "「配布した資料に致命的な古い数値が載っていた」「直前の会議で急遽スライドが追加された」といったトラブルは、イベント運営において日常茶飯事です。紙の資料であれば手遅れですが、FS!QRを使ったデジタル配布なら慌てる必要はありません。"
msgstr ""
"इवेंट मैनेजमेंट में \"वितरित की गई सामग्री में पुरानी और गलत संख्याएं छपी"
" थीं\" या \"ठीक पहले की बैठक में अचानक कुछ नई स्लाइड्स जोड़ी गईं\" जैसी "
"समस्याएं आम बात हैं। यदि कागज की सामग्री हो तो बहुत देर हो चुकी होती है, "
"लेकिन FS!QR का उपयोग करके डिजिटल वितरण के साथ घबराने की कोई आवश्यकता नहीं"
" है।"

msgid "【1時間】送受信がすぐ終わるときに"
msgstr "【1 घंटा】तुरंत भेजने-लेने के लिए"

msgid "【24時間】通常のビジネス連絡に"
msgstr "【24 घंटे】सामान्य व्यावसायिक संपर्क के लिए"

msgid "【6時間・12時間】当日中のやり取りに"
msgstr "【6 घंटे / 12 घंटे】उसी दिन के आदान-प्रदान के लिए"

msgid "【Mac/Windows】PDFの容量が重い！無料でファイルを圧縮して軽くする簡単な方法"
msgstr ""
"【Mac/Windows】PDF फ़ाइल का साइज़ बहुत बड़ा है? मुफ़्त में फ़ाइल को कंप्रेस"
" करने और साइज़ घटाने के आसान तरीके"

msgid "【Macユーザー向け】標準機能「プレビュー」で圧縮する"
msgstr "【Mac यूज़र्स के लिए】 डिफ़ॉल्ट 'Preview' ऐप से कंप्रेस करना"

msgid "【PC・スマホ別】無料で画面録画（スクリーンキャプチャ）をする方法まとめ！動画の共有手段も"
msgstr ""
"[PC और स्मार्टफोन] मुफ़्त में स्क्रीन रिकॉर्ड (स्क्रीन कैप्चर) करने के "
"तरीके! और वीडियो साझा करने के तरीके भी"

msgid "【Windowsユーザー向け】Microsoft Wordを使って圧縮保存する"
msgstr ""
"【Windows यूज़र्स के लिए】 Microsoft Word का इस्तेमाल करके कंप्रेस और सेव "
"करना"

msgid "【セキュリティ上の注意！】"
msgstr "【सुरक्षा चेतावनी!】"

msgid "あくまで公開可能なパンフレットや、一般的な資料の圧縮に限定して利用するのが安全です。"
msgstr ""
"सुरक्षा के लिए, इन सेवाओं का उपयोग केवल सार्वजनिक रूप से साझा करने योग्य "
"ब्रोशर या सामान्य संदर्भ सामग्री को कंप्रेस करने तक ही सीमित रखें।"

msgid "あらかじめファイルをアーカイブ化（ZIP圧縮）する"
msgstr "फ़ाइलों को पहले ही आर्काइव (ZIP में कंप्रेस) करें"

msgid "あらゆるデバイスとOSで使えるマルチ互換性"
msgstr "सभी डिवाइस और OS पर काम करने वाली मल्टी-कंपैटिबिलिटी"

msgid "いいえ、アカウント登録は必要ありません。ノートルームを作成するか、共有されたURLから参加できます。"
msgstr "いいえ、アカウント登録は必要ありません。नोट रूम बनाएँか、शेयर करेंされたURLから参加できます。"

msgid "いいえ。共有リンクまたはQRコードと、発行された6桁のパスワードがあれば受け取れます。アカウント登録は不要です。"
msgstr ""
"नहीं, प्राप्तकर्ताओं को केवल शेयर लिंक या क्यूआर कोड और जारी 6 अंकों के "
"पासवर्ड की आवश्यकता है। किसी खाता पंजीकरण की आवश्यकता नहीं है."

msgid "いずれの機能でもQRコードとパスワードを利用することで、簡単かつ安全に共有できます。"
msgstr ""
"क्यूआर कोड और पासवर्ड का उपयोग करके दोनों कार्यों को आसानी से और सुरक्षित"
" रूप से शेयर किया जा सकता है।"

msgid "いつまでに、どの方法で返答するか。"
msgstr "प्राप्तकर्ता को कब तक और किस माध्यम से जवाब देना है?"

msgid "いつまでもファイルがダウンロード可能な状態にしておくと、古いリンクが意図せず使われる可能性があります。サービスが用意している保持期間やダウンロード回数の設定を確認し、受け渡しに必要な期間だけ共有する運用を選びましょう。"
msgstr ""
"फाइलों को हमेशा के लिए डाउनलोड करने योग्य स्थिति में छोड़ देना सूचना लीक "
"होने के जोखिम को बढ़ाता है। ऐसा सेवा चुनना बेहतर है जो आपको विस्तृत "
"सीमाएं निर्धारित करने की अनुमति देती है, जैसे कि 'एक बार डाउनलोड होने के "
"बाद हटाएं' या '24 घंटे के बाद स्वचालित रूप से हटाएं'।"

msgid "いつまで利用するか"
