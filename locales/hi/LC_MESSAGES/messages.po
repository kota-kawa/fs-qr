msgstr "डाउनलोड बटन दबाने पर भी कुछ न होने पर"

msgid "ダウンロードリンク"
msgstr "डाउनलोड लिंक"

msgid "ダウンロード中..."
msgstr "डाउनलोड हो रहा है..."

