msgstr "リアルタイムでチームの進捗を管理できるGratuitPartagerカンバンTableau de tâchesアプリケーション"

msgid "リアルタイムでノートを共有する手順"
msgstr "Étapes pour partager des notes en temps réel"

msgid "リアルタイムで同時編集"
msgstr "Édition simultanée en temps réel"

msgid "リアルタイムで同期・保存されます"
msgstr "Synchronisé et enregistré en temps réel"

msgid "リアルタイムで複数人が同時編集できる無料オンラインノートアプリケーション"
msgstr ""
"Une application de notes en ligne gratuite qui permet à plusieurs "
"personnes de modifier simultanément en temps réel."

msgid "リアルタイムに同時編集できる共有ノート。メモや議事録の共同編集に活用できます。"
msgstr ""
"Une note partagée modifiable à plusieurs en temps réel. Utile pour la "
"rédaction collaborative de notes et de comptes rendus de réunion."

msgid "リアルタイムノート"
msgstr "notes en temps réel"

msgid "リアルタイムノートルームを開きます。"
msgstr "Ouvre le salon de notes en temps réel."

msgid "リアルタイムノート共有"
msgstr "Partage de notes en temps réel"

msgid ""
"リアルタイムノート共有, 同時編集, オンライン共同編集, ノート作成, ルーム管理, FS QR Note, コラボレーションツール, "
"会議メモ, プロジェクト管理, 学習支援, 無料ノートアプリ, 日本語対応, ブラウザ編集, チーム作業, グループ学習"
msgstr ""
"Partage de notes en temps réel, édition simultanée, édition collaborative"
" en ligne, création de notes, gestion de salon, FS QR Note, outil de "
"collaboration, notes de réunion, gestion de projet, support "
"d'apprentissage, application de notes gratuite, basée sur navigateur, "
"travail d'équipe, apprentissage de groupe"

msgid ""
"リアルタイムノート共有, 同時編集, オンライン共同編集, ノート作成, ルーム管理, FS QR Note, コラボレーションツール, "
"会議メモ, プロジェクト管理, 学習支援, 無料ノートアプリ, 日本語対応, ブラウザ編集, チーム作業, グループ学習, テキスト共有, "
"テキスト共有アプリ, オンラインメモ共有, メモ帳 共有, Webメモ, 議事録 共有, 共同作業"
msgstr ""
"partage de notes en temps réel, édition simultanée, édition collaborative"
" en ligne, création de notes, gestion de salle, FS QR Note, outil de "
