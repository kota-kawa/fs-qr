msgstr "FS!QR Udostępnianie grupowe"

msgid "FS!QR サイト概要 | 無料QRコードファイル共有サービスについて"
msgstr "FS!QR | O serwisie – Usługa udostępniania plików"

msgid "FS!QR サービス"
msgstr "Serwis FS!QR"

msgid "FS!QR サービス一覧へ"
msgstr "Serwis FS!QR一覧へ"

