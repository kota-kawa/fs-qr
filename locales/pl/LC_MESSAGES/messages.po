msgstr "Odszyfrowywanie pliku nie powiodło się."

msgid "復号エラー:"
msgstr "Błąd odszyfrowywania:"

msgid "復号中... 0%"
msgstr "Odszyfrowywanie... 0%%"

msgid "復号中... 100%"
msgstr "Odszyfrowywanie... 100%%"

