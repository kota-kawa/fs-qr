msgstr "Ukryj hasło"

msgid "パスワード・自動削除の仕組み"
msgstr "Jak działają hasła i automatyczne usuwanie"

msgid "パスワード付き"
msgstr "Zabezpieczone hasłem"

msgid "パスワード保護"
msgstr "Ochrona hasłem"

msgid "パスワード保護機能の活用"
msgstr "Korzystanie z ochrony hasłem"

