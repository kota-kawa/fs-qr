msgstr "Thông tin tệp tin | FS!QR - Tải lên hoàn tất"

msgid "ファイル情報, アップロード完了, QRコード生成, ダウンロードリンク, ファイル共有完了, FS QR"
msgstr ""
"thông tin tệp, tải lên hoàn tất, tạo mã QR, liên kết tải xuống, chia sẻ "
"tệp hoàn tất, FS QR"

msgid "ファイル情報の取得に失敗しました。"
msgstr "Không thể lấy thông tin tệp tin."

msgid "ファイル数は最大10個までです"
msgstr "Số lượng tệp tối đa là 10"

msgid "ファイル数は最大10個までです。"
msgstr "Số lượng tệp tối đa là 10."

msgid "ファイル数は最大1個までです。"
msgstr "Số lượng tệp tối đa là 1."

msgid "ファイル数や合計容量の上限に達していないか確認する"
msgstr "Kiểm tra xem có vượt quá giới hạn số tệp hoặc tổng dung lượng hay không"

msgid "ファイル暗号化"
msgstr "ファイルMã hóa"

msgid "ファイル暗号化アップロード"
msgstr "Tải lên tệp tin mã hóa"

msgid "ファイル検索"
msgstr "Tìm kiếm tệp tin"

msgid "ファイル検索 | FS!QR"
msgstr "Tìm kiếm tệp tin | FS!QR"

msgid "ファイル検索 | FS!QR - アップロードファイル検索"
msgstr "Tìm kiếm tệp tin | FS!QR - Tra cứu tệp tin đã tải lên"

msgid "ファイル検索, ファイル管理, アップロードファイル検索, ファイルID検索, ファイルダウンロード, FS QR"
msgstr ""
"tìm kiếm tệp, quản lý tệp, tìm tệp tải lên, tìm ID tệp, tải xuống tệp, FS"
" QR"

msgid "ファイル検索・ダウンロードページに移動します"
msgstr "Di chuyển đến trang tìm kiếm và tải xuống tệp tin"

msgid "ファイル検索機能"
msgstr "Tính năng tìm kiếm tệp tin"

msgid "ファイル置き場"
msgstr "Nơi lưu trữ tệp tin"

msgid "ファイル転送"
msgstr "Chuyển tệp"

msgid "ファイル転送をさらに高速・快適にするテクニック"
msgstr "Mẹo giúp chuyển tệp nhanh hơn và ổn định hơn"

msgid "フォルダを作成し、ファイルをアップロード。コメント機能でタスクのやり取りや進捗共有もできます。"
msgstr ""
"Tạo thư mục riêng và tải các tệp tin lên. Bạn cũng có thể trao đổi công "
"việc và cập nhật tiến độ thông qua tính năng bình luận."

msgid "フォルダ代わりにファイル名のルールをそろえる"
msgstr "Thống nhất quy tắc đặt tên tệp thay vì sử dụng thư mục"

msgid "フォント（文字）が埋め込まれている："
msgstr "Nhúng dữ liệu phông chữ (chữ viết):"

msgid "フッターナビゲーション"
msgstr "Điều hướng chân trang"

msgid "ブラウザからファイルをアップロードし、発行されたURLを相手に送るだけのシンプルな方法です。FS!QRもこれに該当します。手軽さが最大の魅力です。"
msgstr ""
"Tải tệp lên từ trình duyệt rồi gửi URL được tạo ra cho người nhận — đơn "
"giản vậy thôi. FS!QR thuộc loại này. Sự tiện lợi là ưu điểm lớn nhất."

msgid "ブラウザだけでファイルを暗号化。QRコードを読み取って、PC・スマホ間ですばやく一時共有できます。"
msgstr "ブラウザだけでファイルをMã hóa。Mã QRを読み取って、PC・スマホ間ですばやく一時Chia sẻできます。"

msgid "ブラウザだけで完結する！大容量ファイルの共有術"
msgstr "Chia sẻ tệp dung lượng lớn chỉ với trình duyệt — không cần gì thêm!"

msgid "ブラウザでFS!QRを開き、録画した動画ファイルをドラッグ＆ドロップしてアップロードするだけで、相手に伝えるためのダウンロードURLとQRコードが瞬時に発行されます。相手がスマホならQRコードをカメラでスキャンするだけで再生・ダウンロード画面に進めるため、PCからスマホへの動画移動も一瞬で終わります。"
msgstr ""
"Chỉ cần mở FS!QR trên trình duyệt, kéo thả tệp video vào để tải lên, URL "
"tải xuống và mã QR sẽ được tạo ngay lập tức. Người nhận dùng điện thoại "
"chỉ cần quét mã QR bằng camera để mở trang tải xuống, giúp việc chuyển "
"video từ PC sang điện thoại hoàn tất chỉ trong nháy mắt."

msgid "ブラウザでファイルを送った後、「そのデータはいつまでインターネット上に残り続けるのか」という疑問はセキュリティ上の重要な関心事です。"
msgstr ""
"Sau khi gửi tệp qua trình duyệt, câu hỏi \"dữ liệu đó sẽ còn tồn tại trên"
" Internet bao lâu\" là mối lo bảo mật hoàn toàn chính đáng."

msgid "ブラウザでファイルを送った後、そのファイルがずっとインターネット上に残り続けるのは不安なものです。FS!QRは「一時的な共有」を前提としているため、ダウンロードが終われば（あるいは期限が来れば）自動でデータは消去されます。クラウドにデータを貯め込まない、エコで安全な共有方法です。"
msgstr ""
"Sau khi gửi tệp qua trình duyệt, việc tệp cứ nằm mãi trên Internet là "
"điều đáng lo. FS!QR được thiết kế cho \"chia sẻ tạm thời\", nên dữ liệu "
"sẽ được xóa tự động khi tải xuống xong hoặc khi đến thời hạn đã đặt. Đây "
"là cách chia sẻ gọn hơn, không tích trữ dữ liệu không cần thiết trên đám "
"mây."

msgid "ブラウザで完結"
msgstr "Tiện lợi tối đa nhờ hoạt động hoàn toàn trên trình duyệt"

msgid "ブラウザで暗号化"
msgstr "ブラウザでMã hóa"

msgid "ブラウザで暗号化してアップロードすると、受け取りページのURLとQRコードが表示されます。"
msgstr "ブラウザでMã hóaしてTải lênと、受け取りページのURLとMã QRがHiển thịされます。"

msgid "ブラウザのタブやウィンドウを閉じない"
msgstr "Không đóng tab hoặc cửa sổ trình duyệt"

msgid "ブラウザのタブを長時間開いたままにしていると、参加者によって表示内容の更新タイミングがずれることがあります。会議開始前に全員でページを開き直し、冒頭に同じ見出しや日時が表示されているか確認しておくと安心です。"
msgstr ""
"Nếu bạn để tab trình duyệt mở lâu, thời gian cập nhật nội dung hiển thị "
"có thể bị lệch giữa các người tham gia. Trước khi bắt đầu cuộc họp, hãy "
"mở lại trang với tất cả mọi người và kiểm tra xem cùng một tiêu đề hoặc "
"ngày giờ có hiển thị ở đầu sẽ an tâm hơn."

msgid "ブラウザのダウンロード履歴を確認する"
msgstr "Kiểm tra lịch sử tải xuống của trình duyệt"

msgid "ブラウザの仕様によって、ダウンロードボタンを押した後にファイルがそのままブラウザ内で開いてしまうことがあります。その場合は、ブラウザのメニューから「コピーを保存」や「ファイルを保存」を選択するか、共有メニューを経由して保存を行ってください。"
msgstr ""
"Tùy theo thiết lập của trình duyệt, tệp tin có thể tự động mở trực tiếp "
"trên trình duyệt sau khi bạn nhấn nút tải xuống. Trong trường hợp đó, hãy"
" chọn \"Lưu bản sao\" hoặc \"Lưu tệp tin\" từ menu của trình duyệt, hoặc "
"thực hiện lưu tệp thông qua menu chia sẻ."

msgid "ブラウザを更新してファイル一覧を読み直す"
msgstr "Làm mới trình duyệt để đọc lại danh sách tệp"

msgid "ブラウザを更新して最新の内容を読み直す"
msgstr "Làm mới trình duyệt để đọc lại nội dung mới nhất"

msgid "ブラウザを更新する"
msgstr "Làm mới trình duyệt"

msgid "ブラウザベースで大きなデータを確実に転送するためには、いくつか知っておくと便利なコツがあります。"
msgstr ""
"Để truyền dữ liệu lớn một cách đáng tin cậy qua trình duyệt, có một vài "
"mẹo nhỏ hữu ích bạn nên biết."

msgid "ブラウザ上でのファイル暗号化"
msgstr "ブラウザ上でのファイルMã hóa"

msgid "ブラウザ完結だからこその手軽さ"
msgstr "Sự tiện lợi của việc chỉ dùng trình duyệt"

msgid ""
"ブラウザ完結の最大の強みは、デバイスやOSの壁を完全に無視できる点にあります。Windows、Mac、Linux、iPadOS、iOS、Androidのどれを組み合わせても問題ありません。「iPhoneからWindows"
" "
"PCへ」「MacからAndroidスマホへ」といった、従来ならBluetooth転送やAirDropなどが使えず面倒だった組み合わせでも、FS!QRのWebページにアクセスするだけで瞬時に繋がります。この圧倒的なアクセシビリティを活かし、チームの作業スピードをさらに加速させましょう。"
msgstr ""
"Ưu điểm lớn nhất của việc hoạt động hoàn toàn trên trình duyệt là không "
"bị ràng buộc bởi thiết bị hay hệ điều hành. Tự do kết hợp Windows, Mac, "
"Linux, iPadOS, iOS hay Android — không vấn đề gì. Những tổ hợp từng rất "
"phiền phức vì không dùng được Bluetooth hay AirDrop — như \"từ iPhone "
"sang Windows PC\" hay \"từ Mac sang điện thoại Android\" — nay chỉ cần cả"
" hai bên mở trang web FS!QR là kết nối ngay lập tức. Hãy tận dụng khả "
"năng tương thích vượt trội này để đẩy nhanh tốc độ làm việc của cả nhóm."

msgid "ブラウザ完結型"
msgstr "Không cần cài đặt ứng dụng (chạy hoàn toàn trên trình duyệt)"

msgid "ブラウザ対応"
msgstr "Hỗ trợ trình duyệt"

msgid "ブラウザ対応:"
msgstr "Hỗ trợ trình duyệt:"

msgid "ブラウザ（Safari/Chrome）の履歴・キャッシュ削除："
msgstr "Xóa lịch sử và bộ nhớ đệm của trình duyệt (Safari/Chrome):"

msgid "ブレインストーミング用のルームを作成して全員が同時に書き込み。リアルタイムで互いの意見が見え、議論が活発になります。"
msgstr ""
"Tạo phòng để lên ý tưởng động não và cho phép mọi người cùng viết đồng "
"thời. Nhìn thấy ý kiến của nhau trong thời gian thực giúp thảo luận sôi "
"nổi hơn."

msgid "ブレインストーミング："
msgstr "Brainstorming:"

msgid "ブレインストーミング： アイデア出しのディスカッションにおいて、各自のPCから付箋のようにテキストを書き込み、全員でリアルタイムに可視化します。"
msgstr ""
"Động não (Brainstorming): Trong các cuộc thảo luận đưa ra ý tưởng, mỗi "
"người có thể viết nội dung từ máy tính cá nhân của mình giống như dán "
"giấy ghi chú, hiển thị trực quan cho tất cả mọi người cùng xem trong thời"
" gian thực."

msgid "プライバシーに関する問い合わせ、削除依頼、違法または権利侵害のおそれがあるコンテンツの通報も、このフォームから受け付けています。対象URL、ルームID、問題の内容、返信先をできるだけ具体的に記載してください。"
msgstr ""
"Các câu hỏi về quyền riêng tư, yêu cầu xóa và báo cáo nội dung có thể vi "
"phạm pháp luật hay xâm phạm quyền cũng được tiếp nhận qua biểu mẫu này. "
"Vui lòng cung cấp URL liên quan, ID phòng, mô tả vấn đề và thông tin liên"
" lạc càng chi tiết càng tốt."

msgid "プライバシーの保護："
msgstr "Bảo vệ quyền riêng tư:"

msgid "プライバシーの保護：氏名やメールアドレスといった個人情報をサービス提供側に渡す必要がありません。個人情報の流出リスクを根本から減らすことができます。"
msgstr ""
"Bảo vệ quyền riêng tư: Không cần cung cấp thông tin cá nhân như họ tên "
"hoặc địa chỉ email cho nhà cung cấp dịch vụ. Điều này giúp giảm thiểu tận"
" gốc nguy cơ rò rỉ thông tin cá nhân."

msgid "プライバシーを守る「使い捨て」の仕組み"
msgstr "Cơ chế chia sẻ 'dùng một lần' giúp bảo vệ quyền riêng tư"

msgid "プライバシーポリシー"
msgstr "Chính sách bảo mật"

msgid "プライバシー保護のため、ファイルは一定期間後に自動削除されます。一時的な共有に特化した設計です。"
msgstr ""
"Để bảo vệ quyền riêng tư, mọi tệp tin sẽ tự động bị xóa sau một thời gian"
" nhất định. Đây là thiết kế tối ưu dành riêng cho nhu cầu chia sẻ tạm "
"thời."

msgid "プレビュー"
msgstr "Xem trước"

msgid "プレビューを閉じる"
msgstr "Đóng xem trước"

msgid "プロジェクトが終了したり、メンバーが退職したりした後も、古い共有リンクが生き続けていることで、元メンバーがいつでもデータにアクセスできてしまう状態の放置。"
msgstr ""
"Các liên kết chia sẻ cũ vẫn tồn tại sau khi dự án kết thúc hoặc thành "
"viên rời đi, để lộ một kẽ hở cho phép cựu thành viên truy cập dữ liệu bất"
" cứ lúc nào."

msgid "プロジェクトごとにルームを作成して資料・報告書・画像データを集約。メールの添付ファイルが散らばらず、最新版の管理が容易になります。"
msgstr ""
"Tạo phòng riêng cho từng dự án để tập hợp tài liệu, báo cáo, dữ liệu hình"
" ảnh. Các tệp đính kèm không bị phân tán rải rác trong email, giúp dễ "
"dàng quản lý phiên bản mới nhất."

msgid "プロジェクトチーム内でのファイル共有は、業務効率に直結する重要な要素です。FS!QRを活用することで、設計図面、仕様書、進捗報告書などの重要な文書を迅速かつ安全に共有できます。特に外部パートナーとの協働プロジェクトでは、従来のメール添付やクラウドサービスのアカウント共有が困難な場合でも、QRコードとパスワードによる簡単な共有が可能になります。ファイルの一時的な性質により、プロジェクト終了後の情報漏えいリスクも最小化できます。"
msgstr ""
"Chia sẻ tệp trong nhóm dự án là yếu tố then chốt ảnh hưởng trực tiếp đến "
"năng suất. FS!QR cho phép bạn chia sẻ nhanh chóng và an toàn các tài liệu"
" quan trọng như bản vẽ thiết kế, thông số kỹ thuật hay báo cáo tiến độ. "
"Đặc biệt trong các dự án cộng tác với đối tác bên ngoài — nơi gửi đính "
"kèm email hay chia sẻ tài khoản đám mây gặp nhiều hạn chế — bạn có thể "
"giải quyết dễ dàng chỉ bằng mã QR và mật khẩu. Vì tệp chỉ tồn tại tạm "
"thời, nguy cơ rò rỉ thông tin sau khi dự án kết thúc cũng được giảm thiểu"
" tối đa."

msgid "プロジェクト管理とチーム協働の効率化"
msgstr "Tối ưu hóa quản lý dự án và cộng tác nhóm"

msgid "プロジェクト管理支援"
msgstr "Hỗ trợ quản lý dự án"

msgid "ヘルプ"
msgstr "Trợ giúp"

msgid "ヘルプを閉じる"
msgstr "Đóng trợ giúp"

msgid "ヘルプを開く"
msgstr "Mở trợ giúp"

msgid "ページは開けるのにダウンロードが始まらない場合、ブラウザのポップアップ制限、通信の不安定さ、ファイルサイズ、端末の空き容量などが関係します。スマートフォンでは、ダウンロード後の保存先が見つからず「失敗した」と勘違いされることもあります。"
msgstr ""
"Nếu trang mở được nhưng tải xuống không bắt đầu, điều này có liên quan "
"đến hạn chế cửa sổ bật lên của trình duyệt, kết nối không ổn định, kích "
"thước tệp, dung lượng trống của thiết bị, v.v. Trên điện thoại thông "
"minh, đôi khi nơi lưu trữ sau tải xuống không thể tìm thấy và bị nhầm lẫn"
" là \"thất bại\"."

msgid "ページをご確認ください。"
msgstr "để biết chi tiết."

msgid "ページ上に表示されたファイル名とサイズを確認し、「ダウンロード」ボタンをタップします。処理が完了すると端末にファイルが保存されます。"
msgstr ""
"Xác nhận tên tệp và kích thước được hiển thị trên trang, sau đó nhấn nút "
"\"Tải xuống\". Khi quá trình hoàn thành, tệp sẽ được lưu trên thiết bị."

msgid "ペースト"
msgstr "Dán"

msgid "ペーパーレス化は環境に優しいだけでなく、運営の効率化と情報のアクセシビリティ向上を同時にもたらします。次回のイベントや会議では、ぜひFS!QRを使ったスマートな資料配布を取り入れてみてください。"
msgstr ""
"Văn phòng không giấy tờ (Paperless) không chỉ giúp bảo vệ môi trường mà "
"còn tối ưu hóa hiệu quả vận hành, đồng thời cải thiện đáng kể khả năng "
"tiếp cận thông tin của mọi người. Trong sự kiện hoặc cuộc họp tiếp theo, "
"hãy thử ứng dụng giải pháp phân phối tài liệu thông minh bằng FS!QR."

msgid "ホーム"
msgstr "Trang chủ"

msgid "ホームに戻る"
msgstr "Quay lại trang chủ"

msgid "ホームへ"
msgstr "Tới trang chủ"

msgid "ホームへ戻る"
msgstr "Quay lại trang chủ"

msgid "ホーム画面から青いフォルダアイコンの「ファイル」アプリを起動します。"
msgstr ""
"Mở ứng dụng \"Tệp\" có biểu tượng thư mục màu xanh dương từ màn hình "
"chính."

msgid "ボタンを押すとノートルームが作られ、下書きがそのまま引き継がれます。"
msgstr "ボタンを押すとGhi chúPhòngが作られ、下書きがそのまま引き継がれます。"

msgid "ボードの操作"
msgstr "ボードのThao tác"

msgid "ボードを作成"
msgstr "ボードをTạo"

msgid "ボードを削除"
msgstr "ボードをXóa"

