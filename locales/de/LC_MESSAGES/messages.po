msgstr "Artikel 1 (Antrag)"

msgid "第2条（定義）"
msgstr "Artikel 2 (Definition)"

msgid "第3条（サービスの内容と無償提供）"
msgstr "Artikel 3 (Dienstinhalt und kostenlose Bereitstellung)"

msgid "第4条（利用者の責任）"
msgstr "Artikel 4 (Verantwortung des Nutzers)"

msgid "第5条（禁止事項）"
msgstr "Artikel 5 (Verbotene Angelegenheiten)"

msgid "第6条（コンテンツの取り扱いと自動削除）"
msgstr "Artikel 6 (Umgang mit Inhalten und automatische Löschung)"

msgid "第7条（知的財産権）"
msgstr "Artikel 7 (Geistige Eigentumsrechte)"

msgid "第8条（サービスの中断・変更・終了）"
msgstr "Artikel 8 (Suspendierung, Änderung, Beendigung des Dienstes)"

